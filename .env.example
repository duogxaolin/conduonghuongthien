# ─── MySQL ───────────────────────────────────────
# BẮT BUỘC — để trống thì `docker compose` dừng ngay với thông báo nêu đúng tên
# biến còn thiếu. Cố ý không đặt sẵn giá trị chạy được: một mật khẩu mẫu nằm
# trong repo public là mật khẩu đã lộ, và nó lại chạy được nên không ai nhận ra.
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=cdkt_admin
MYSQL_USER=cdkt_user
MYSQL_EXTERNAL_PORT=33069

# ─── Kết nối DB của ứng dụng ─────────────────────
# Mặc định dùng root cho tương thích ngược. Để chạy tối thiểu đặc quyền:
#   DB_USER=cdkt_user
#   DB_PASSWORD=<đúng bằng MYSQL_PASSWORD ở trên>
# DB_USER=root
# DB_PASSWORD=

# Khi chạy PM2/aaPanel (không qua Docker) cần khai báo đầy đủ:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cdkt_admin

# ─── App ─────────────────────────────────────────
PORT=54432
NODE_ENV=production

# ─── Bí mật: BẮT BUỘC ở production, phải là giá trị RIÊNG của bạn ──
# Ứng dụng sẽ từ chối khởi động ở production nếu thiếu hoặc dùng giá trị mặc định cũ.
# Tạo: openssl rand -hex 32
# ⚠️ Xoay JWT_SECRET làm VÔ HIỆU HOÁ toàn bộ secret TOTP đã lưu (khoá mã hoá
#    dẫn xuất từ nó) — đọc runbook trong CLAUDE.md trước khi đổi.
JWT_SECRET=thay-bang-chuoi-random-rieng-cua-ban

# Tạo: openssl rand -base64 32   (phải là base64 của đúng 32 byte)
CHATBOT_ENCRYPTION_SECRET=thay-bang-chuoi-random-base64-32-byte

# Tạo: openssl rand -hex 32  (tối thiểu 32 ký tự)
# LƯU Ý: Nitro đọc biến có tiền tố NUXT_ lúc chạy — docker-compose đã tự ánh xạ
# ANALYTICS_HMAC_SECRET sang NUXT_ANALYTICS_HMAC_SECRET giúp bạn.
#
# Biến này có HAI người dùng, không chỉ analytics: nó cũng ký vé phiên trò chuyện
# của chatbot (`server/utils/chatbot/session-token.ts`). Hệ quả:
#   • Thiếu biến → `/api/public/chatbot/session` trả 503 và phần lưu lịch sử chat
#     dừng hẳn. Chatbot vẫn trả lời, chỉ là không phiên nào được ghi vào CSDL nên
#     /admin/chatbot/sessions trống.
#   • Xoay biến → mọi vé đang phát mất hiệu lực. Khách đang mở chat sẽ được cấp
#     vé mới ở tin nhắn kế tiếp; hậu quả duy nhất là một cuộc hội thoại bị chẻ
#     thành hai phiên trong trang quản trị. Không mất dữ liệu đã ghi.
ANALYTICS_HMAC_SECRET=thay-bang-chuoi-random-dai-it-nhat-32-ky-tu

# Công tắc thu thập analytics. Phải đặt CẢ HAI dòng cùng giá trị: compose KHÔNG
# suy ra dòng NUXT_ từ dòng trần (khác với HMAC_SECRET ở trên). Chỉ đổi một dòng
# thành false là tắt nửa vời — cấu hình lúc build tắt, runtime vẫn bật.
ANALYTICS_COLLECTION_ENABLED=true
NUXT_ANALYTICS_COLLECTION_ENABLED=true

# ─── Tài khoản quản trị khởi tạo ─────────────────
# CHỈ dùng lần đầu tạo tài khoản. Seed là insert-only nên các lần chạy sau
# KHÔNG ghi đè mật khẩu đã đổi.
# BẮT BUỘC. Tối thiểu 12 ký tự, đủ 3/4 nhóm ký tự. Sinh bằng:
#   openssl rand -base64 18
# KHÔNG được chứa chuỗi "admin" (tên tài khoản seed, không phân biệt hoa/thường)
# — "Admin@..." sẽ bị từ chối. `npm run build` kiểm tra giá trị này TRƯỚC khi
# build, nên sai là dừng ngay chứ không đợi tới lúc seed.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@conduonghuongthien.com.vn

# ─── Chính sách lưu trữ dữ liệu cá nhân ──────────
# activity_logs ghi 1 dòng mỗi lần đăng nhập và mỗi thao tác CRUD, kèm IP +
# User-Agent trong cột meta. Mặc định giữ 365 ngày; đặt 0 để giữ vĩnh viễn.
# ACTIVITY_LOG_RETENTION_DAYS=365
#
# submissions chứa họ tên, số điện thoại, email, địa chỉ người dân gửi vào.
# Mặc định 0 = KHÔNG tự xóa, vì thời hạn lưu hồ sơ công dân do quy định lưu trữ
# của cơ quan quyết định, không phải do mã nguồn. Đặt số ngày khi đã có quy định.
# SUBMISSION_RETENTION_DAYS=0
#
# chat_sessions chứa lịch sử trò chuyện chatbot với IP, user-agent, và thông tin
# liên hệ phát hiện được (tên, số điện thoại). Mặc định 90 ngày: đủ để tương quan
# một cuộc hội thoại với đơn gửi sau đó, nhưng đủ ngắn để lịch sử duyệt web không
# tích tụ vô hạn.
# CHAT_SESSION_RETENTION_DAYS=90
#
# chat_messages KHÔNG có cửa sổ riêng, và cố ý như vậy: FK của nó có ON DELETE
# CASCADE nên tin nhắn đi theo phiên. Một cửa sổ độc lập sẽ xoá tin nhắn trong khi
# hàng phiên còn sống và vẫn khai có N tin, còn một cap số bản ghi sẽ cắt ngang
# một hội thoại. (Trước đây tệp này có khai CHAT_MESSAGE_RETENTION_DAYS và
# CHAT_MESSAGE_MAX_ROWS — không mã nào đọc chúng, nên đó là hai núm không làm gì
# mà lại khiến người vận hành tin rằng mình đã đặt được thời hạn.)
#
# reader_accounts chứa danh tính Google của người bình luận (subject id, email, tên
# hiển thị) kèm IP và trình duyệt lần gần nhất. Mặc định 365 ngày — dài hơn phiên
# chat vì xoá một tài khoản người đọc là xoá luôn toàn bộ bình luận công khai của
# họ, kể cả phản hồi của Ban quản trị nằm dưới. Tính tuổi theo `last_seen_at`, KHÔNG
# theo ngày tạo: một tài khoản mở ba năm trước mà vừa bình luận hôm qua là người đọc
# đang hoạt động. article_comments không có cửa sổ riêng, cùng lý do như chat_messages.
# READER_ACCOUNT_RETENTION_DAYS=365
#
# (Tùy chọn) Giới hạn số bản ghi tối đa. Phần vượt cap bị xóa (cũ nhất trước). Mặc
# định 0 = không giới hạn. Kết hợp với retention days: cap chặn bảng phình nhanh
# hơn cửa sổ lưu, retention days bảo đảm chính sách. Đo chỉ một lần lúc bắt đầu lượt
# dọn, nên bản ghi đến trong lúc chạy không đẩy phần xóa vào vùng còn trong cap.
# ACTIVITY_LOG_MAX_ROWS=0
# SUBMISSION_MAX_ROWS=0
# CHAT_SESSION_MAX_ROWS=0
# READER_ACCOUNT_MAX_ROWS=0
#
# Các biến trên chỉ là GIÁ TRỊ KHỞI ĐIỂM. Khi quản trị viên lưu cấu hình tại
# /admin/settings/data-retention thì giá trị trong CSDL thắng, và trang đó sẽ nói
# rõ từng ô đang lấy từ đâu (đặt tại đây / biến môi trường / mặc định) — sửa tệp
# này mà không thấy gì thay đổi thì nguyên nhân là vậy.

# ─── Tự động dọn dữ liệu ─────────────────────────
# Máy chủ tự chạy lượt dọn, không cần đặt cron. Bật/tắt và giờ chạy cũng đặt được
# tại /admin/settings/data-retention (CSDL thắng biến môi trường).
# RETENTION_AUTO_ENABLED=true
# RETENTION_RUN_HOUR=3
#
# Bộ đếm lịch trong tiến trình: mặc định BẬT ở production, TẮT ở môi trường phát
# triển (một lượt dọn im lặng khi đang xem dữ liệu seed là mất chính dữ liệu đang
# xem). Đặt 1 để bật khi chạy dev, 0 để tắt và giao lại việc cho cron.
# RETENTION_SCHEDULER=1

# ─── Lượt xem bài viết ───
# Bộ đếm giao dần lượt xem ảo (chế độ "cộng dần" tại /admin/content/articles).
# Mặc định BẬT ở production, TẮT ở môi trường phát triển — cùng hình dạng với
# RETENTION_SCHEDULER ở trên, để hai bộ đếm lịch trong cùng một mã nguồn không
# có mặc định ngược nhau. Đặt 1 để xem một lượt cộng dần chạy khi phát triển.
# Tắt KHÔNG huỷ lượt nào: phần còn thiếu được tính theo thời gian đã trôi qua,
# nên lượt chạy đầu tiên sau khi bật lại giao trọn phần còn nợ.
# VIEW_BOOST_SCHEDULER=1

# ─── Reverse proxy (BẮT BUỘC khi có nginx/aaPanel đứng trước) ───
# Địa chỉ của CHÍNH proxy của bạn. Chỉ những địa chỉ này được phép nói thay
# khách qua `x-forwarded-for`.
#
# Bỏ trống = chỉ tin loopback. Đúng khi app nhận request trực tiếp, nhưng SAI
# khi có nginx: lúc đó mọi khách đến từ cùng một địa chỉ (gateway của docker
# bridge), nên giới hạn tần suất theo IP gộp thành MỘT bucket dùng chung cho cả
# internet — khách thứ 11 gửi tin nhắn trong một phút bị chặn vì 10 người lạ —
# và `activity_logs` / `submissions` ghi IP của proxy thay vì của khách.
#
# Tên network lấy theo TÊN THƯ MỤC chứa docker-compose.yml, nên phải tự dò chứ
# không chép giá trị mẫu — đặt sai là một lỗi hoàn toàn IM LẶNG:
#   docker network ls | grep default
#   docker network inspect <tên-vừa-thấy> --format '{{(index .IPAM.Config 0).Gateway}}'
# Nhận địa chỉ đơn lẻ hoặc dải CIDR IPv4, cách nhau bằng dấu phẩy.
# TRUSTED_PROXY_IPS=

# ─── Đăng nhập Google cho người đọc (bình luận) ───
# Địa chỉ công khai của cổng, dùng để dựng redirect URI gửi cho Google:
#   <PUBLIC_BASE_URL>/api/auth/google/callback
# Google so khớp chuỗi này TỪNG KÝ TỰ với giá trị đã khai trong Cloud Console —
# khác một dấu gạch chéo cuối hay một chữ `www.` là `redirect_uri_mismatch`.
#
# KHÔNG bắt buộc để khởi động: bỏ trống thì địa chỉ được suy từ chính request
# (có tôn trọng `x-forwarded-host` nhưng CHỈ khi peer đúng là proxy đã khai ở
# TRUSTED_PROXY_IPS), và trang /admin/settings/google-oauth sẽ hiện cảnh báo nói
# rõ giá trị đang lấy từ đâu. Ở production nên đặt tường minh: sau reverse proxy
# hoặc khi đổi tên miền, chuỗi suy ra có thể khác đi mà không có gì báo.
#
# Client ID và Client secret KHÔNG đặt ở đây — nhập tại
# /admin/settings/google-oauth, secret được mã hoá bằng CHATBOT_ENCRYPTION_SECRET
# (biến đó nay bảo vệ hai thứ: API key chatbot và secret Google).
# PUBLIC_BASE_URL=https://conduonghuongthien.com.vn
# NUXT_PUBLIC_BASE_URL=https://conduonghuongthien.com.vn

# Giao diện mà cổng ứng dụng lắng nghe. Mặc định 127.0.0.1 — nginx proxy vào đó.
# Chỉ đổi thành 0.0.0.0 nếu KHÔNG có proxy nào và TLS được kết thúc ở chỗ khác;
# mở ra ngoài trong lúc vẫn có proxy nghĩa là HTTP trần đi vòng qua SSL.
# APP_BIND=127.0.0.1

# ─── CI/CD: image được triển khai ────────────────
# Job deploy ghi đè ĐÚNG dòng này mỗi lần merge vào main (tag sha-<commit>).
# Giá trị dưới đây chỉ để lần chạy đầu có cái mà kéo. Bỏ trống thì compose lùi về
# `cdkt/app:local` và tự BUILD tại chỗ — đúng cái mà CI/CD đang tránh.
# Xem CI-CD.md.
# CDKT_IMAGE=ghcr.io/<owner>/<repo>:latest

# ─── (Tùy chọn) Tài nguyên container & độ bền ────
# Giới hạn RAM. MySQL tự dò giới hạn này (cgroup) — KHÔNG dò RAM của máy chủ —
# để tính InnoDB buffer pool, nên đặt quá thấp là ép nó chạy chật trên máy rộng.
# Mặc định 1g/1g chọn cho VPS 1–2 GB. Máy ≥ 8 GB nên nới, ví dụ 4g/2g.
# Vẫn nên GIỮ giới hạn thay vì bỏ hẳn: một MySQL không trần có thể khiến
# OOM-killer hạ một container KHÁC trên cùng máy chủ.
#
# Không đoán hai con số này: chạy `npm run check:resources` TRÊN MÁY CHỦ. Script
# đọc RAM thật, trần đang đặt, mức đang dùng, và đếm cả container của dự án khác
# rồi in ra đúng hai dòng để dán vào đây. Nó chỉ đọc, không sửa gì.
# MYSQL_MEM_LIMIT=1g
# APP_MEM_LIMIT=1g
#
# strict = full ACID (innodb_flush_log_at_trx_commit=1) — chậm hơn, không mất
# giao dịch khi HOST mất điện. Mặc định fast = có thể mất ~1 giây giao dịch cuối.
# MYSQL_DURABILITY=fast

# ─── (Tùy chọn) Analytics nâng cao ───────────────
# ANALYTICS_RAW_RETENTION_DAYS=14
# ANALYTICS_AGGREGATE_RETENTION_DAYS=762
# ANALYTICS_DEFAULT_RANGE_DAYS=30
# ANALYTICS_MAX_RANGE_DAYS=366
# ANALYTICS_FRESHNESS_THRESHOLD_HOURS=48

# ─── (Tùy chọn) Sao lưu & nhật ký ────────────────
# scripts/backup-db.sh đọc hai biến này khi chạy từ cron.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
#
# Mức log có cấu trúc: debug | info | warn | error. Mặc định info.
# LOG_LEVEL=info
