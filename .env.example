# ─── MySQL ───────────────────────────────────────
# BẮT BUỘC (docker compose sẽ báo lỗi nếu thiếu)
MYSQL_ROOT_PASSWORD=ThayDoiMatKhauRoot123!
MYSQL_DATABASE=cdkt_admin
MYSQL_USER=cdkt_user
MYSQL_PASSWORD=ThayDoiMatKhauUser456!
MYSQL_EXTERNAL_PORT=33069

# ─── Kết nối DB của ứng dụng ─────────────────────
# Mặc định dùng root cho tương thích ngược. Để chạy tối thiểu đặc quyền:
#   DB_USER=cdkt_user
#   DB_PASSWORD=<đúng bằng MYSQL_PASSWORD ở trên>
# DB_USER=root
# DB_PASSWORD=

# Khi chạy PM2/aaPanel (không qua Docker) cần khai báo đầy đủ:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cdkt_admin

# ─── App ─────────────────────────────────────────
PORT=54432
NODE_ENV=production

# ─── Bí mật: BẮT BUỘC ở production, phải là giá trị RIÊNG của bạn ──
# Ứng dụng sẽ từ chối khởi động ở production nếu thiếu hoặc dùng giá trị mặc định cũ.
# Tạo: openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-random-rieng-cua-ban

# Tạo: openssl rand -base64 32   (phải là base64 của đúng 32 byte)
CHATBOT_ENCRYPTION_SECRET=thay-bang-chuoi-random-base64-32-byte

# Tạo: openssl rand -hex 32  (tối thiểu 32 ký tự)
# LƯU Ý: Nitro đọc biến có tiền tố NUXT_ lúc chạy — docker-compose đã tự ánh xạ
# ANALYTICS_HMAC_SECRET sang NUXT_ANALYTICS_HMAC_SECRET giúp bạn.
ANALYTICS_HMAC_SECRET=thay-bang-chuoi-random-dai-it-nhat-32-ky-tu
ANALYTICS_COLLECTION_ENABLED=true
NUXT_ANALYTICS_COLLECTION_ENABLED=true

# ─── Tài khoản quản trị khởi tạo ─────────────────
# CHỈ dùng lần đầu tạo tài khoản. Seed là insert-only nên các lần chạy sau
# KHÔNG ghi đè mật khẩu đã đổi.
ADMIN_PASSWORD=DoiMatKhauManhNgayLanDau!
ADMIN_EMAIL=admin@conduonghuongthien.com.vn

# ─── (Tùy chọn) Analytics nâng cao ───────────────
# ANALYTICS_RAW_RETENTION_DAYS=14
# ANALYTICS_AGGREGATE_RETENTION_DAYS=762
# ANALYTICS_DEFAULT_RANGE_DAYS=30
# ANALYTICS_MAX_RANGE_DAYS=366
# ANALYTICS_FRESHNESS_THRESHOLD_HOURS=48

# ─── (Tùy chọn) AI Chatbot ───────────────────────
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
