# ─── MySQL ───────────────────────────────────────
# BẮT BUỘC (docker compose sẽ báo lỗi nếu thiếu)
MYSQL_ROOT_PASSWORD=ThayDoiMatKhauRoot123!
MYSQL_DATABASE=cdkt_admin
MYSQL_USER=cdkt_user
MYSQL_PASSWORD=ThayDoiMatKhauUser456!
MYSQL_EXTERNAL_PORT=33069

# ─── Kết nối DB của ứng dụng ─────────────────────
# Mặc định dùng root cho tương thích ngược. Để chạy tối thiểu đặc quyền:
#   DB_USER=cdkt_user
#   DB_PASSWORD=<đúng bằng MYSQL_PASSWORD ở trên>
# DB_USER=root
# DB_PASSWORD=

# Khi chạy PM2/aaPanel (không qua Docker) cần khai báo đầy đủ:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cdkt_admin

# ─── App ─────────────────────────────────────────
PORT=54432
NODE_ENV=production

# ─── Bí mật: BẮT BUỘC ở production, phải là giá trị RIÊNG của bạn ──
# Ứng dụng sẽ từ chối khởi động ở production nếu thiếu hoặc dùng giá trị mặc định cũ.
# Tạo: openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-random-rieng-cua-ban

# Tạo: openssl rand -base64 32   (phải là base64 của đúng 32 byte)
CHATBOT_ENCRYPTION_SECRET=thay-bang-chuoi-random-base64-32-byte

# Tạo: openssl rand -hex 32  (tối thiểu 32 ký tự)
# LƯU Ý: Nitro đọc biến có tiền tố NUXT_ lúc chạy — docker-compose đã tự ánh xạ
# ANALYTICS_HMAC_SECRET sang NUXT_ANALYTICS_HMAC_SECRET giúp bạn.
ANALYTICS_HMAC_SECRET=thay-bang-chuoi-random-dai-it-nhat-32-ky-tu
ANALYTICS_COLLECTION_ENABLED=true
NUXT_ANALYTICS_COLLECTION_ENABLED=true

# ─── Tài khoản quản trị khởi tạo ─────────────────
# CHỈ dùng lần đầu tạo tài khoản. Seed là insert-only nên các lần chạy sau
# KHÔNG ghi đè mật khẩu đã đổi.
# BẮT BUỘC. Tối thiểu 12 ký tự, đủ 3/4 nhóm ký tự. Sinh bằng:
#   openssl rand -base64 18
# KHÔNG được chứa chuỗi "admin" (tên tài khoản seed, không phân biệt hoa/thường)
# — "Admin@..." sẽ bị từ chối. `npm run build` kiểm tra giá trị này TRƯỚC khi
# build, nên sai là dừng ngay chứ không đợi tới lúc seed.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@conduonghuongthien.com.vn

# ─── Chính sách lưu trữ dữ liệu cá nhân ──────────
# activity_logs ghi 1 dòng mỗi lần đăng nhập và mỗi thao tác CRUD, kèm IP +
# User-Agent trong cột meta. Mặc định giữ 365 ngày; đặt 0 để giữ vĩnh viễn.
# ACTIVITY_LOG_RETENTION_DAYS=365
#
# submissions chứa họ tên, số điện thoại, email, địa chỉ người dân gửi vào.
# Mặc định 0 = KHÔNG tự xóa, vì thời hạn lưu hồ sơ công dân do quy định lưu trữ
# của cơ quan quyết định, không phải do mã nguồn. Đặt số ngày khi đã có quy định.
# SUBMISSION_RETENTION_DAYS=0
#
# Hai biến trên chỉ là GIÁ TRỊ KHỞI ĐIỂM. Khi quản trị viên lưu cấu hình tại
# /admin/settings/data-retention thì giá trị trong CSDL thắng, và trang đó sẽ nói
# rõ từng ô đang lấy từ đâu (đặt tại đây / biến môi trường / mặc định) — sửa tệp
# này mà không thấy gì thay đổi thì nguyên nhân là vậy.

# ─── Tự động dọn dữ liệu ─────────────────────────
# Máy chủ tự chạy lượt dọn, không cần đặt cron. Bật/tắt và giờ chạy cũng đặt được
# tại /admin/settings/data-retention (CSDL thắng biến môi trường).
# RETENTION_AUTO_ENABLED=true
# RETENTION_RUN_HOUR=3
#
# Bộ đếm lịch trong tiến trình: mặc định BẬT ở production, TẮT ở môi trường phát
# triển (một lượt dọn im lặng khi đang xem dữ liệu seed là mất chính dữ liệu đang
# xem). Đặt 1 để bật khi chạy dev, 0 để tắt và giao lại việc cho cron.
# RETENTION_SCHEDULER=1

# ─── (Tùy chọn) Analytics nâng cao ───────────────
# ANALYTICS_RAW_RETENTION_DAYS=14
# ANALYTICS_AGGREGATE_RETENTION_DAYS=762
# ANALYTICS_DEFAULT_RANGE_DAYS=30
# ANALYTICS_MAX_RANGE_DAYS=366
# ANALYTICS_FRESHNESS_THRESHOLD_HOURS=48

# ─── (Tùy chọn) AI Chatbot ───────────────────────
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
