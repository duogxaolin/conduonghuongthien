{
  "name": "frontend_nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run check:admin-password && nuxt build",
    "check:admin-password": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/check-admin-password.ts",
    "lint": "eslint . --max-warnings=9999",
    "lint:fix": "eslint . --fix --max-warnings=9999",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,css,md}\" --ignore-path .prettierignore",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --import ./scripts/ts-resolver.mjs --test tests/*.test.ts tests/ratchets/*.test.ts",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('node_modules/.cache/cdkt-coverage', { recursive: true })\" && node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --import ./scripts/ts-resolver.mjs --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=node_modules/.cache/cdkt-coverage/lcov.info --test \"tests/!(*-integration).test.ts\" \"tests/ratchets/*.test.ts\" && node --experimental-strip-types scripts/coverage-summary.ts node_modules/.cache/cdkt-coverage/lcov.info && node --experimental-strip-types scripts/coverage-ratchet.ts node_modules/.cache/cdkt-coverage/lcov.info",
    "test:watch": "node --experimental-strip-types --experimental-test-module-mocks --import ./scripts/ts-resolver.mjs --test --watch tests/*.test.ts tests/ratchets/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "analytics:maintenance": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/analytics-maintenance.ts",
    "check:resources": "bash scripts/check-resources.sh",
    "make:favicon": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/make-favicon.ts",
    "db:init": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs server/db/init.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs server/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:sanitize-html": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/sanitize-stored-html.ts",
    "db:decode-excerpts": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/decode-stored-excerpts.ts",
    "db:repair-null-translations": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/repair-null-translations.ts",
    "db:repair-ai-usage-duplicates": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/repair-ai-usage-duplicates.ts",
    "db:drift": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/check-schema-drift.ts",
    "docs:facts": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/docs-facts.ts"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^27.0.0",
    "@googleapis/sheets": "^18.1.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.2",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5",
    "svg-captcha": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "1.64.1",
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "hls.js": "^1.7.4",
    "js-yaml": "^4.3.2",
    "mermaid": "^12.1.0",
    "nuxt": "^4.6.3",
    "plyr": "^3.8.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vue": "^3.5.43",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "devalue": "^5.9.1",
    "svgo": "^4.1.0"
  },
  "optionalDependencies": {
    "archiver": "^7.0.1"
  }
}
