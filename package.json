{
  "name": "frontend_nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run check:admin-password && nuxt build",
    "check:admin-password": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/check-admin-password.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --import ./scripts/ts-resolver.mjs --test tests/*.test.ts",
    "test:watch": "node --experimental-strip-types --experimental-test-module-mocks --import ./scripts/ts-resolver.mjs --test --watch tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "analytics:maintenance": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/analytics-maintenance.ts",
    "check:resources": "bash scripts/check-resources.sh",
    "make:favicon": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/make-favicon.ts",
    "db:init": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs server/db/init.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs server/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:drift": "node --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/check-schema-drift.ts"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.5.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/sharp": "^0.31.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.8"
  }
}
