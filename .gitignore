# Large binary assets (tracked separately or ignored)
*.zip

# FontAwesome Pro — track css + webfonts (7MB), skip js SVG bundles (112MB)
public/assets/fontawesome/js/
public/assets/fontawesome/sprites/
public/assets/fontawesome/svgs/
public/assets/fontawesome/less/
public/assets/fontawesome/scss/
public/assets/fontawesome/metadata/
.claude/
.mcp.json

# ─── Sao lưu database do bạn tự tạo ───
# Các dump chính thức trong migrations/ vẫn được track (xem header cảnh báo
# trong từng tệp). Chỉ bỏ qua bản sao lưu tạm sinh ra khi vận hành.
*.dump.sql
backup_*.sql

# Bản sao lưu do scripts/backup-db.sh sinh ra
backups/

# ─── Kết quả chạy Playwright ───
# Trace và ảnh chụp chỉ giữ lại khi test đỏ, nên đây là tệp gỡ lỗi tạm.
playwright-report/
test-results/
blob-report/
.playwright/
