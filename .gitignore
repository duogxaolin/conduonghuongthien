# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs — chỉ bỏ qua thư mục logs ở root, không khớp server/api/.../logs/
/logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Temporary / working directories
TMP/

# Large binary assets (tracked separately or ignored)
*.zip

# FontAwesome Pro — track css + webfonts (7MB), skip js SVG bundles (112MB)
public/assets/fontawesome/js/
public/assets/fontawesome/sprites/
public/assets/fontawesome/svgs/
public/assets/fontawesome/less/
public/assets/fontawesome/scss/
public/assets/fontawesome/metadata/
.claude/
.mcp.json

# ─── Sao lưu database do bạn tự tạo ───
# Các dump chính thức trong migrations/ vẫn được track (xem header cảnh báo
# trong từng tệp). Chỉ bỏ qua bản sao lưu tạm sinh ra khi vận hành.
*.dump.sql
backup_*.sql

# Bản sao lưu do scripts/backup-db.sh sinh ra
backups/

# Trên VPS: bản sao lưu docker-compose.yml (deploy-remote.sh + manage.sh Update) và
# tệp compose CI gửi lên trước khi kiểm checksum. Không được lọt vào `git status`
# — cây "bẩn" là thứ làm `git pull` của Update từ chối.
.deploy-compose-backups/
.docker-compose.incoming.yml
# Override riêng của máy chủ: log json-file dự phòng khi VPS không có journald (do
# deploy-remote.sh / manage.sh ghi, có dấu `# cdkt-log-fallback`), hoặc của người vận hành;
# và tệp tạm của bản override đó trước khi `mv` (lượt bị cắt ngang có thể để lại).
docker-compose.override.yml
.docker-compose.override.*
# Dump CSDL trước mỗi lượt deploy (toàn bộ dữ liệu production — không bao giờ được
# commit) và scripts/backup-db.sh CI gửi lên trong lúc deploy.
.deploy-db-backups/
.deploy-incoming/

# ─── Kết quả chạy Playwright ───
# Trace và ảnh chụp chỉ giữ lại khi test đỏ, nên đây là tệp gỡ lỗi tạm.
playwright-report/
test-results/
blob-report/
.playwright/

# Migration data — source cổng cũ ASP.NET, đã migrate xong, không cần nữa
old-data/
.migrate/

# production/migrations/ marker đã import (tự tạo)
production/migrations/.imported-*

# Runtime uploads — không track ảnh/uploads vào git
public/uploads/
cdkt-uploads-missing492-manual.tar.gz
# Dữ liệu bản sao và clone tạm thời
CDKT/
*.sql.gz
scripts/pack-missing-media.mjs
